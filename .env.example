# Jira must be reachable from the machine/container running this bot (for example, while connected to the corporate VPN).
JIRA_BASE_URL=https://jira.example.com
JIRA_BOARD_ID=42
# Jira status name to watch. Change this one value to watch a different status.
JIRA_STATUS="Ревью СА выполнено"

# Jira auth: basic (Jira Cloud email + API token, or username/password), bearer (PAT), or none.
JIRA_AUTH_MODE=basic
JIRA_USERNAME=your-jira-user-or-email
JIRA_PASSWORD=your-jira-api-token-or-password
# For bearer auth, set JIRA_AUTH_MODE=bearer and provide JIRA_TOKEN instead.
JIRA_TOKEN=
# For browser-session auth, set JIRA_AUTH_MODE=cookie and provide the complete Cookie header value.
# Treat this as a password; it may expire. Never commit or share it.
JIRA_COOKIE=

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-chat-id

POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
DATABASE_PATH=data/seen_issues.sqlite3
# false = first start records current matches silently; true = notify for all current matches at first start.
NOTIFY_EXISTING_ON_START=false
LOG_LEVEL=INFO
